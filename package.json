{
  "name": "modern-json-formatter",
  "description": "Format JSON in a modern way. With guaranteed order of keys, big numbers, jq queries, expandable/collapsable properties and more.",
  "version": "2.1.0",
  "type": "module",
  "author": {
    "name": "Evgeny Abramovich",
    "email": "evg.abramovitch@gmail.com"
  },
  "bugs": {
    "url": "https://github.com/evg4b/modern-json-formatter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:evg4b/modern-json-formatter.git"
  },
  "homepage": "https://github.com/evg4b/modern-json-formatter",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "NODE_ENV=development rsbuild build",
    "build:production": "NODE_ENV=production rsbuild build",
    "dev": "NODE_ENV=development rsbuild build --watch",
    "lint": "eslint .",
    "test": "rstest",
    "test:cover": "rstest --coverage",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lit/context": "^1.1.6",
    "@playwright/test": "^1.64.0",
    "@rsbuild/core": "^2.2.12",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.1",
    "@rstest/core": "^0.12.3",
    "@rstest/coverage-istanbul": "^0.12.3",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chrome": "^0.3.4",
    "@types/golang-wasm-exec": "^1.15.2",
    "@types/node": "^26.6.4",
    "@types/semver": "^7.8.0",
    "@webcomponents/custom-elements": "^1.6.0",
    "es-toolkit": "^1.52.0",
    "eslint": "^10.12.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-wc": "^3.1.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "htmlnano": "^3.5.1",
    "lit": "^3.3.3",
    "marked": "^18.1.0",
    "marked-gfm-heading-id": "^4.1.4",
    "rsbuild-lit-markdown": "^1.1.0",
    "semver": "^7.8.5",
    "storybook": "^10.6.1",
    "storybook-web-components-rsbuild": "^3.6.0",
    "type-fest": "^5.10.0",
    "typed-assert": "^1.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "picomatch": "^4.0.4"
  }
}
